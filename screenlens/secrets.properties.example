# Copy this file to secrets.properties (git-ignored) and fill in real values
# for LOCAL release builds only. Never commit secrets.properties.
#
# For CI (GitHub Actions), do NOT use this file — configure the equivalent
# GitHub Secrets instead (see README.md -> "GitHub Actions / Secrets setup"):
#   KEYSTORE_BASE64, KEYSTORE_PASSWORD, KEY_ALIAS, KEY_PASSWORD

# Path to your release keystore file (absolute or relative to project root)
KEYSTORE_FILE=

# Release keystore password
KEYSTORE_PASSWORD=

# Release key alias
KEY_ALIAS=

# Release key password
KEY_PASSWORD=

# AdMob application ID (from AdMob console). Leave blank during development
# to fall back to Google's public test app ID.
ADMOB_APP_ID=

# AdMob ad unit IDs used only in release builds. Leave blank to fall back to
# Google's public test ad unit IDs (debug builds always use test IDs).
BANNER_AD_UNIT_ID=
INTERSTITIAL_AD_UNIT_ID=
