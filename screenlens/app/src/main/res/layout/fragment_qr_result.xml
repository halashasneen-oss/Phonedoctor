<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:orientation="vertical"
    android:padding="@dimen/space_lg">

    <TextView
        android:id="@+id/resultTypeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/qr_result_text_type"
        android:textAppearance="@style/TextAppearance.ScreenLens.Label" />

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.ScreenLens.Card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_sm"
        android:layout_weight="1">

        <TextView
            android:id="@+id/rawValueText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.ScreenLens.Body"
            android:textIsSelectable="true"
            tools:text="https://example.com" />

    </com.google.android.material.card.MaterialCardView>

    <Button
        android:id="@+id/openLinkButton"
        style="@style/Widget.ScreenLens.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:text="@string/action_open_link"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:orientation="horizontal">

        <Button
            android:id="@+id/copyButton"
            style="@style/Widget.ScreenLens.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_xs"
            android:layout_weight="1"
            android:text="@string/action_copy" />

        <Button
            android:id="@+id/shareButton"
            style="@style/Widget.ScreenLens.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:layout_weight="1"
            android:text="@string/action_share" />

    </LinearLayout>

</LinearLayout>
