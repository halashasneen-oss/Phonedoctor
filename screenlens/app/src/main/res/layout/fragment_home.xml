<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_2xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/space_lg"
            android:paddingVertical="@dimen/space_md">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textAppearance="@style/TextAppearance.ScreenLens.Title"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/settingsButton"
                style="@style/Widget.ScreenLens.Button.IconOnly"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_settings_icon"
                android:src="@drawable/ic_nav_settings" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_lg"
            android:text="@string/home_greeting"
            android:textAppearance="@style/TextAppearance.ScreenLens.Headline" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.ScreenLens.Card.Hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/space_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="@dimen/icon_size_xl"
                    android:layout_height="@dimen/icon_size_xl"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_nav_scan" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:text="@string/home_scan_card_title"
                    android:textAppearance="@style/TextAppearance.ScreenLens.Title"
                    android:textColor="@color/brand_on_primary_container"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2xs"
                    android:text="@string/home_scan_card_desc"
                    android:textAppearance="@style/TextAppearance.ScreenLens.BodySecondary"
                    android:textColor="@color/brand_on_primary_container" />

                <Button
                    android:id="@+id/scanScreenButton"
                    style="@style/Widget.ScreenLens.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:text="@string/action_scan_screen" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_lg"
            android:layout_marginBottom="@dimen/space_sm"
            android:text="@string/home_quick_actions"
            android:textAppearance="@style/TextAppearance.ScreenLens.Label" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_lg"
            android:columnCount="2"
            android:useDefaultMargins="false">

            <include
                android:id="@+id/quickActionImageOcr"
                layout="@layout/item_quick_action" />
            <include
                android:id="@+id/quickActionTranslate"
                layout="@layout/item_quick_action" />
            <include
                android:id="@+id/quickActionClipboard"
                layout="@layout/item_quick_action" />
            <include
                android:id="@+id/quickActionQr"
                layout="@layout/item_quick_action" />

        </GridLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_lg"
            android:layout_marginTop="@dimen/space_xl"
            android:layout_marginBottom="@dimen/space_sm"
            android:text="@string/home_recent_scans"
            android:textAppearance="@style/TextAppearance.ScreenLens.Label" />

        <LinearLayout
            android:id="@+id/recentScansContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_lg"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/emptyStateContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_lg"
            android:layout_marginTop="@dimen/space_md"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="@dimen/space_xl"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_no_scans"
                android:textAppearance="@style/TextAppearance.ScreenLens.BodySecondary" />

            <Button
                android:id="@+id/startFirstScanButton"
                style="@style/Widget.ScreenLens.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/action_start_first_scan" />

        </LinearLayout>

        <com.google.android.gms.ads.AdView
            android:id="@+id/bannerAd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:visibility="gone" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
