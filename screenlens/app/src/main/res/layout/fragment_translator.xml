<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_lg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/sourceLanguageButton"
                style="@style/Widget.ScreenLens.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="English" />

            <ImageButton
                android:id="@+id/swapButton"
                style="@style/Widget.ScreenLens.Button.IconOnly"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:layout_marginHorizontal="@dimen/space_xs"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_swap_languages"
                android:src="@drawable/ic_swap" />

            <Button
                android:id="@+id/targetLanguageButton"
                style="@style/Widget.ScreenLens.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Arabic" />

        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.ScreenLens.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_original_text"
                    android:textAppearance="@style/TextAppearance.ScreenLens.Label" />

                <EditText
                    android:id="@+id/inputText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:background="@android:color/transparent"
                    android:gravity="top|start"
                    android:hint="@string/hint_enter_text"
                    android:inputType="textMultiLine"
                    android:minLines="3"
                    android:textAppearance="@style/TextAppearance.ScreenLens.Body" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.ScreenLens.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_translated_text"
                    android:textAppearance="@style/TextAppearance.ScreenLens.Label" />

                <ProgressBar
                    android:id="@+id/translatingProgress"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="@dimen/space_sm"
                    android:indeterminateTint="@color/brand_primary"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/outputText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:textAppearance="@style/TextAppearance.ScreenLens.Body"
                    android:textIsSelectable="true"
                    tools:text="منذ متى الشحن يستغرق؟" />

                <LinearLayout
                    android:id="@+id/modelMissingContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/modelMissingText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/error_model_missing"
                        android:textAppearance="@style/TextAppearance.ScreenLens.BodySecondary" />

                    <Button
                        android:id="@+id/downloadModelButton"
                        style="@style/Widget.ScreenLens.Button.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:text="@string/action_download" />

                    <ProgressBar
                        android:id="@+id/downloadProgress"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginTop="@dimen/space_sm"
                        android:indeterminateTint="@color/brand_primary"
                        android:visibility="gone" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:orientation="horizontal">

            <Button
                android:id="@+id/copyButton"
                style="@style/Widget.ScreenLens.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_xs"
                android:layout_weight="1"
                android:text="@string/action_copy" />

            <Button
                android:id="@+id/shareButton"
                style="@style/Widget.ScreenLens.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_xs"
                android:layout_weight="1"
                android:text="@string/action_share" />

            <Button
                android:id="@+id/saveButton"
                style="@style/Widget.ScreenLens.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:layout_weight="1"
                android:text="@string/action_save" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
