<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/space_2xl">

    <ImageView
        android:id="@+id/pageIcon"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:importantForAccessibility="no"
        tools:src="@drawable/ic_onboarding_read" />

    <TextView
        android:id="@+id/pageTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2xl"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.ScreenLens.Headline"
        tools:text="Read Any Screen" />

    <TextView
        android:id="@+id/pageDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.ScreenLens.BodySecondary"
        tools:text="Extract text from images and supported screen captures." />

</LinearLayout>
