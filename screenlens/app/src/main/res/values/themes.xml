<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base app theme. Uses the DayNight parent so System theme mode is native;
         explicit Light/Dark overrides are applied at runtime via
         AppCompatDelegate.setDefaultNightMode() from Settings > Appearance. -->
    <style name="Theme.ScreenLens" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorPrimaryContainer">@color/brand_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/brand_on_primary_container</item>
        <item name="colorSecondary">@color/brand_primary</item>
        <item name="colorOnSecondary">@color/brand_on_primary</item>

        <item name="android:colorBackground">@color/color_background</item>
        <item name="colorSurface">@color/color_surface</item>
        <item name="colorOnSurface">@color/color_text_primary</item>
        <item name="colorSurfaceVariant">@color/color_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/color_text_secondary</item>
        <item name="colorOutline">@color/color_outline</item>

        <item name="colorError">@color/color_error</item>
        <item name="colorOnError">@color/white</item>
        <item name="colorErrorContainer">@color/color_error_container</item>

        <item name="android:statusBarColor">@color/color_background</item>
        <item name="android:navigationBarColor">@color/color_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>

        <item name="materialAlertDialogTheme">@style/ThemeOverlay.ScreenLens.Dialog</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.ScreenLens.BottomSheet</item>
    </style>

    <style name="Theme.ScreenLens.NoActionBar" parent="Theme.ScreenLens" />

    <style name="Theme.ScreenLens.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/color_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_screenlens_logo</item>
        <item name="windowSplashScreenAnimationDuration">450</item>
        <item name="postSplashScreenTheme">@style/Theme.ScreenLens</item>
    </style>

    <style name="Theme.ScreenLens.Transparent" parent="Theme.ScreenLens">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="ThemeOverlay.ScreenLens.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorSurface">@color/color_surface</item>
    </style>

    <style name="ThemeOverlay.ScreenLens.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.ScreenLens.BottomSheet</item>
    </style>

    <style name="Widget.ScreenLens.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="shapeAppearance">@style/ShapeAppearance.ScreenLens.TopRounded</item>
        <item name="backgroundTint">@color/color_surface</item>
    </style>

    <style name="ShapeAppearance.ScreenLens.TopRounded" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/radius_lg</item>
        <item name="cornerSizeTopRight">@dimen/radius_lg</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

</resources>
