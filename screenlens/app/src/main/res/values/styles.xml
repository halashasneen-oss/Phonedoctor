<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ===== Buttons ===== -->
    <style name="Widget.ScreenLens.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/brand_primary</item>
        <item name="android:textColor">@color/brand_on_primary</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:paddingTop">@dimen/space_md</item>
        <item name="android:paddingBottom">@dimen/space_md</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.ScreenLens.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/color_outline</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
    </style>

    <style name="Widget.ScreenLens.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/brand_primary</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
    </style>

    <style name="Widget.ScreenLens.Button.IconOnly" parent="Widget.Material3.Button.IconButton">
        <item name="android:minWidth">@dimen/touch_target_min</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="iconTint">@color/color_text_primary</item>
    </style>

    <!-- ===== Cards ===== -->
    <style name="Widget.ScreenLens.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/color_surface</item>
        <item name="cardCornerRadius">@dimen/radius_lg</item>
        <item name="cardElevation">@dimen/elevation_card</item>
        <item name="contentPadding">@dimen/space_lg</item>
        <item name="strokeColor">@color/color_outline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.ScreenLens.Card.Hero" parent="Widget.ScreenLens.Card">
        <item name="cardBackgroundColor">@color/brand_primary_container</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- ===== Text appearances ===== -->
    <style name="TextAppearance.ScreenLens.Display" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.ScreenLens.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.ScreenLens.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/color_text_primary</item>
    </style>

    <style name="TextAppearance.ScreenLens.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/color_text_primary</item>
    </style>

    <style name="TextAppearance.ScreenLens.BodySecondary" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/color_text_secondary</item>
    </style>

    <style name="TextAppearance.ScreenLens.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textColor">@color/color_text_secondary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="TextAppearance.ScreenLens.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/color_text_secondary</item>
    </style>

    <!-- ===== Chips (filters) ===== -->
    <style name="Widget.ScreenLens.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/color_surface_variant</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="chipStrokeColor">@color/color_outline</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="checkedIconVisible">false</item>
    </style>

    <!-- ===== Bottom navigation ===== -->
    <style name="Widget.ScreenLens.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/color_surface</item>
        <item name="itemIconTint">@color/bottom_nav_item_color</item>
        <item name="itemTextColor">@color/bottom_nav_item_color</item>
        <item name="elevation">@dimen/elevation_raised</item>
    </style>

    <!-- ===== Toolbar ===== -->
    <style name="Widget.ScreenLens.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/color_background</item>
        <item name="titleTextColor">@color/color_text_primary</item>
        <item name="android:minHeight">?attr/actionBarSize</item>
    </style>

</resources>
