<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/onboardingFragment"
        android:name="com.phonedoctor.app.ui.onboarding.OnboardingFragment"
        tools:layout="@layout/fragment_onboarding">
        <action
            android:id="@+id/action_onboarding_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/onboardingFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.phonedoctor.app.ui.home.HomeFragment"
        tools:layout="@layout/fragment_home">
        <action android:id="@+id/action_home_to_scan" app:destination="@id/scanFragment" />
        <action android:id="@+id/action_home_to_settings" app:destination="@id/settingsFragment" />
        <action android:id="@+id/action_home_to_battery" app:destination="@id/batteryFragment" />
        <action android:id="@+id/action_home_to_storage" app:destination="@id/storageFragment" />
        <action android:id="@+id/action_home_to_memory" app:destination="@id/memoryFragment" />
        <action android:id="@+id/action_home_to_display" app:destination="@id/displayTestFragment" />
        <action android:id="@+id/action_home_to_touch" app:destination="@id/touchTestFragment" />
        <action android:id="@+id/action_home_to_speaker" app:destination="@id/speakerTestFragment" />
        <action android:id="@+id/action_home_to_microphone" app:destination="@id/microphoneTestFragment" />
        <action android:id="@+id/action_home_to_camera" app:destination="@id/cameraTestFragment" />
        <action android:id="@+id/action_home_to_sensors" app:destination="@id/sensorsTestFragment" />
        <action android:id="@+id/action_home_to_connectivity" app:destination="@id/connectivityTestFragment" />
        <action android:id="@+id/action_home_to_history" app:destination="@id/testHistoryFragment" />
        <action android:id="@+id/action_home_to_vibration" app:destination="@id/vibrationTestFragment" />
        <action android:id="@+id/action_home_to_flashlight" app:destination="@id/flashlightTestFragment" />
        <action android:id="@+id/action_home_to_cpu" app:destination="@id/cpuFragment" />
    </fragment>

    <fragment
        android:id="@+id/scanFragment"
        android:name="com.phonedoctor.app.ui.scan.ScanFragment"
        tools:layout="@layout/fragment_scan">
        <action
            android:id="@+id/action_scan_to_results"
            app:destination="@id/scanResultsFragment"
            app:popUpTo="@id/homeFragment" />
    </fragment>

    <fragment
        android:id="@+id/scanResultsFragment"
        android:name="com.phonedoctor.app.ui.results.ScanResultsFragment"
        tools:layout="@layout/fragment_scan_results">
        <argument android:name="reportId" app:argType="long" />
        <action android:id="@+id/action_results_to_report" app:destination="@id/reportDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/batteryFragment"
        android:name="com.phonedoctor.app.ui.battery.BatteryFragment"
        tools:layout="@layout/fragment_battery" />

    <fragment
        android:id="@+id/storageFragment"
        android:name="com.phonedoctor.app.ui.storage.StorageFragment"
        tools:layout="@layout/fragment_storage" />

    <fragment
        android:id="@+id/memoryFragment"
        android:name="com.phonedoctor.app.ui.memory.MemoryFragment"
        tools:layout="@layout/fragment_memory" />

    <fragment
        android:id="@+id/cpuFragment"
        android:name="com.phonedoctor.app.ui.cpu.CpuFragment"
        tools:layout="@layout/fragment_cpu" />

    <fragment
        android:id="@+id/displayTestFragment"
        android:name="com.phonedoctor.app.ui.display.DisplayTestFragment"
        tools:layout="@layout/fragment_display_test" />

    <fragment
        android:id="@+id/touchTestFragment"
        android:name="com.phonedoctor.app.ui.touch.TouchTestFragment"
        tools:layout="@layout/fragment_touch_test" />

    <fragment
        android:id="@+id/speakerTestFragment"
        android:name="com.phonedoctor.app.ui.speaker.SpeakerTestFragment"
        tools:layout="@layout/fragment_speaker_test" />

    <fragment
        android:id="@+id/microphoneTestFragment"
        android:name="com.phonedoctor.app.ui.microphone.MicrophoneTestFragment"
        tools:layout="@layout/fragment_microphone_test" />

    <fragment
        android:id="@+id/vibrationTestFragment"
        android:name="com.phonedoctor.app.ui.vibration.VibrationTestFragment"
        tools:layout="@layout/fragment_vibration_test" />

    <fragment
        android:id="@+id/flashlightTestFragment"
        android:name="com.phonedoctor.app.ui.flashlight.FlashlightTestFragment"
        tools:layout="@layout/fragment_flashlight_test" />

    <fragment
        android:id="@+id/cameraTestFragment"
        android:name="com.phonedoctor.app.ui.camera.CameraTestFragment"
        tools:layout="@layout/fragment_camera_test" />

    <fragment
        android:id="@+id/sensorsTestFragment"
        android:name="com.phonedoctor.app.ui.sensors.SensorsTestFragment"
        tools:layout="@layout/fragment_sensors_test" />

    <fragment
        android:id="@+id/connectivityTestFragment"
        android:name="com.phonedoctor.app.ui.connectivity.ConnectivityTestFragment"
        tools:layout="@layout/fragment_connectivity_test" />

    <fragment
        android:id="@+id/deviceInformationFragment"
        android:name="com.phonedoctor.app.ui.deviceinfo.DeviceInformationFragment"
        tools:layout="@layout/fragment_device_information" />

    <fragment
        android:id="@+id/testHistoryFragment"
        android:name="com.phonedoctor.app.ui.history.TestHistoryFragment"
        tools:layout="@layout/fragment_test_history">
        <action android:id="@+id/action_history_to_report" app:destination="@id/reportDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/reportDetailsFragment"
        android:name="com.phonedoctor.app.ui.report.ReportDetailsFragment"
        tools:layout="@layout/fragment_report_details">
        <argument android:name="reportId" app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.phonedoctor.app.ui.settings.SettingsFragment"
        tools:layout="@layout/fragment_settings">
        <action android:id="@+id/action_settings_to_privacy" app:destination="@id/privacyFragment" />
        <action android:id="@+id/action_settings_to_about" app:destination="@id/aboutFragment" />
        <action android:id="@+id/action_settings_to_premium" app:destination="@id/premiumFragment" />
        <action android:id="@+id/action_settings_to_help" app:destination="@id/helpFragment" />
        <action android:id="@+id/action_settings_to_device_info" app:destination="@id/deviceInformationFragment" />
    </fragment>

    <fragment
        android:id="@+id/aboutFragment"
        android:name="com.phonedoctor.app.ui.about.AboutFragment"
        tools:layout="@layout/fragment_about" />

    <fragment
        android:id="@+id/privacyFragment"
        android:name="com.phonedoctor.app.ui.privacy.PrivacyFragment"
        tools:layout="@layout/fragment_privacy" />

    <fragment
        android:id="@+id/premiumFragment"
        android:name="com.phonedoctor.app.ui.premium.PremiumFragment"
        tools:layout="@layout/fragment_premium" />

    <fragment
        android:id="@+id/helpFragment"
        android:name="com.phonedoctor.app.ui.help.HelpFaqFragment"
        tools:layout="@layout/fragment_help_faq" />

</navigation>
