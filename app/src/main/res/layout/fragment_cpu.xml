<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/buttonBack"
                android:layout_width="@dimen/min_touch_target"
                android:layout_height="@dimen/min_touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_back"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/color_text_primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_xs"
                android:layout_weight="1"
                android:text="@string/cpu_title"
                android:textAppearance="@style/TextAppearance.PhoneDoctor.Title" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.PhoneDoctor.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            app:contentPadding="0dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:paddingVertical="@dimen/spacing_xs"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="10"
                tools:listitem="@layout/item_info_row" />

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonRefresh"
            style="@style/Widget.PhoneDoctor.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/cpu_refresh_info" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.PhoneDoctor.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cpu_benchmark_title"
                    android:textAppearance="@style/TextAppearance.PhoneDoctor.Subtitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="@string/cpu_benchmark_desc"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="@dimen/text_body" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonRunBenchmark"
                    style="@style/Widget.PhoneDoctor.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/cpu_run_benchmark" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progressBenchmark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/textBenchmarkResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/text_body"
                    android:visibility="gone"
                    tools:text="Single: 12,345,678 ops/s
Multi: 45,678,901 ops/s
Workers: 8"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/textBenchmarkNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="@string/cpu_benchmark_note"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="@dimen/text_caption"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.PhoneDoctor.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cpu_stress_title"
                    android:textAppearance="@style/TextAppearance.PhoneDoctor.Subtitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="@string/cpu_stress_desc"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="@dimen/text_body" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonRunStress"
                    style="@style/Widget.PhoneDoctor.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/cpu_run_stress" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressStress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:max="100"
                    android:visibility="gone"
                    tools:progress="60"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/textStressProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:gravity="center_horizontal"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="@dimen/text_caption"
                    android:visibility="gone"
                    tools:text="Stress test 60%"
                    tools:visibility="visible" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonCancelStress"
                    style="@style/Widget.PhoneDoctor.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/cpu_cancel_stress"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/textStressResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/text_body"
                    android:visibility="gone"
                    tools:text="Sustained performance: 91%"
                    tools:visibility="visible" />
            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/textCpuError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:textColor="@color/color_error"
            android:textSize="@dimen/text_body"
            android:visibility="gone"
            tools:text="CPU benchmark failed"
            tools:visibility="visible" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
