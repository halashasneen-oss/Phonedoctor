<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/spacing_xs"
    android:checkable="true"
    android:minHeight="104dp"
    app:cardBackgroundColor="@color/color_card_elevated"
    app:cardCornerRadius="@dimen/radius_md"
    app:cardElevation="3dp"
    app:rippleColor="@color/color_ripple"
    app:strokeColor="@color/color_outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_icon_tile">

            <ImageView
                android:id="@+id/imageIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:tint="@color/color_primary"
                tools:src="@drawable/ic_vibration" />
        </FrameLayout>

        <TextView
            android:id="@+id/textTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:gravity="center"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.PhoneDoctor.Subtitle"
            tools:text="@string/vibration_title" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
