<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_xs"
    android:checkable="true"
    android:minHeight="@dimen/min_touch_target"
    app:cardBackgroundColor="@color/color_card"
    app:cardCornerRadius="@dimen/radius_md"
    app:cardElevation="0dp"
    app:rippleColor="@color/color_ripple"
    app:strokeColor="@color/color_divider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_sm">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_icon_tile">

            <ImageView
                android:id="@+id/imageIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:tint="@color/color_primary"
                tools:src="@drawable/ic_vibration" />
        </FrameLayout>

        <TextView
            android:id="@+id/textTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.PhoneDoctor.Subtitle"
            tools:text="@string/vibration_title" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_right"
            android:tint="@color/color_text_secondary" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
