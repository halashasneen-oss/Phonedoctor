<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/buttonBack"
                android:layout_width="@dimen/min_touch_target"
                android:layout_height="@dimen/min_touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_back"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/color_text_primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_xs"
                android:layout_weight="1"
                android:text="@string/vibration_title"
                android:textAppearance="@style/TextAppearance.PhoneDoctor.Title" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/spacing_lg"
            android:background="@drawable/bg_icon_tile">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_vibration"
                app:tint="@color/color_primary" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:gravity="center"
            android:text="@string/vibration_instructions"
            android:textAppearance="@style/TextAppearance.PhoneDoctor.Body" />

        <TextView
            android:id="@+id/textAmplitudeSupport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.PhoneDoctor.Caption"
            tools:text="Amplitude control: Available" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.PhoneDoctor.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/vibration_capabilities_title"
                    android:textAppearance="@style/TextAppearance.PhoneDoctor.Subtitle" />

                <TextView
                    android:id="@+id/textVibrationCapabilities"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:textAppearance="@style/TextAppearance.PhoneDoctor.Caption"
                    tools:text="Vibrator ID: 1&#10;Effects: Click ✓, Tick ✓&#10;Primitives: Click ✓ (20ms)" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonShort"
            style="@style/Widget.PhoneDoctor.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="@string/vibration_test_short" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonLong"
            style="@style/Widget.PhoneDoctor.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:text="@string/vibration_test_long" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonPattern"
            style="@style/Widget.PhoneDoctor.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:text="@string/vibration_test_pattern" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonClickEffect"
            style="@style/Widget.PhoneDoctor.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:text="@string/vibration_test_click_effect" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/vibration_user_verify_note"
            android:textAppearance="@style/TextAppearance.PhoneDoctor.Caption" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
