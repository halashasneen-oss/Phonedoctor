<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/buttonBack"
                android:layout_width="@dimen/min_touch_target"
                android:layout_height="@dimen/min_touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_back"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/color_text_primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_xs"
                android:layout_weight="1"
                android:text="@string/mic_title"
                android:textAppearance="@style/TextAppearance.PhoneDoctor.Title" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/spacing_lg"
            android:background="@drawable/bg_icon_tile">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_microphone"
                app:tint="@color/color_primary" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:gravity="center"
            android:text="@string/mic_instructions"
            android:textAppearance="@style/TextAppearance.PhoneDoctor.Body" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/levelMeter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:max="100"
            app:indicatorColor="@color/color_primary"
            app:trackColor="@color/color_surface_variant"
            app:trackCornerRadius="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xxs"
            android:text="@string/mic_input_level"
            android:textAppearance="@style/TextAppearance.PhoneDoctor.Caption" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:gravity="center"
            android:text="@string/mic_max_duration_notice"
            android:textAppearance="@style/TextAppearance.PhoneDoctor.Caption" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonRecord"
            style="@style/Widget.PhoneDoctor.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="@string/mic_start_recording" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonPlay"
            style="@style/Widget.PhoneDoctor.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:enabled="false"
            android:text="@string/mic_play_recording" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonDelete"
            style="@style/Widget.PhoneDoctor.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="@string/mic_delete_recording" />

        <TextView
            android:id="@+id/textMicStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:background="@drawable/bg_alert_info"
            android:padding="@dimen/spacing_sm"
            android:textAppearance="@style/TextAppearance.PhoneDoctor.Body"
            android:visibility="gone"
            tools:text="Average: 31%&#10;Peak: 85%&#10;Clipping samples: 0"
            tools:visibility="visible" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.PhoneDoctor.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mic_input_routes"
                    android:textAppearance="@style/TextAppearance.PhoneDoctor.Subtitle" />

                <TextView
                    android:id="@+id/textInputRoutes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:textAppearance="@style/TextAppearance.PhoneDoctor.Body"
                    tools:text="Built-in microphone" />
            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/mic_stats_note"
            android:textAppearance="@style/TextAppearance.PhoneDoctor.Caption" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
