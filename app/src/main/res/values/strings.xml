    <!-- ============ About ============ -->
    <string name="about_title">About</string>
    <string name="about_version_fmt">Version %1$s</string>
    <string name="about_description">Phone Doctor performs a complete diagnostic check of your device\'s hardware and software components, entirely on your device.</string>
    <string name="about_developer">Developed by the Phone Doctor team</string>

    <!-- ============ Privacy ============ -->
    <string name="privacy_title">Privacy</string>
    <string name="privacy_intro">Phone Doctor is designed to perform device diagnostics locally whenever possible. Diagnostic results and personal files are not uploaded to a Phone Doctor server.</string>
    <string name="privacy_data_body">Phone Doctor does not collect your IMEI, serial number, advertising ID, or MAC address. Test history, settings and any temporary recordings are stored only on your device and can be deleted at any time from Settings.</string>
    <string name="privacy_ads_title">Advertising</string>
    <string name="privacy_ads_body">The free version of Phone Doctor may show ads served by Google AdMob. Ads may use data according to Google\'s advertising and consent settings. You can remove ads with Phone Doctor Premium.</string>
    <string name="privacy_permissions_title">Permissions</string>
    <string name="privacy_permissions_body">Camera, microphone, storage and notification permissions are only requested when you open the matching test, and only used for that test.</string>

