    <!-- ============ About ============ -->
    <string name="about_title">About</string>
    <string name="about_version_fmt">Version %1$s</string>
    <string name="about_description">Phone Doctor performs a complete diagnostic check of your device\'s hardware and software components, entirely on your device.</string>
    <string name="about_developer">Developed by the Phone Doctor team</string>

    <!-- ============ Privacy ============ -->
    <string name="privacy_title">Privacy</string>
    <string name="privacy_intro">Phone Doctor is designed to perform device diagnostics locally whenever possible. Diagnostic results and personal files are not uploaded to a Phone Doctor server.</string>
    <string name="privacy_data_body">Phone Doctor does not collect your IMEI, serial number, MAC address, account credentials, or personal files. Test history, settings and temporary microphone recordings stay in app-private storage on your device. The optional DNS/TCP connectivity test contacts example.com only when you start it and does not upload personal data.</string>
    <string name="privacy_ads_title">Advertising</string>
    <string name="privacy_ads_body">Phone Doctor may show ads served by Google AdMob. Where required, Google\'s UMP consent flow is shown before ad requests, and eligible users can reopen ad privacy choices from Settings. The optional rewarded-ad flow can disable Phone Doctor ads for one hour after the reward is earned.</string>
    <string name="privacy_permissions_title">Permissions</string>
    <string name="privacy_permissions_body">Camera and microphone are requested only for their matching test screens. Bluetooth Connect is requested only when needed to read Bluetooth state on newer Android versions. Notifications are requested only if you enable reminders. Phone Doctor does not request broad photo, video, audio-library, external-storage, or location permission for diagnostics.</string>

